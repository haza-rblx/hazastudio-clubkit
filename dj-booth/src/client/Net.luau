function SerdesFunctions.ReadFUNCTION_RETURN_Do(): ({ Ok: boolean, Message: string?, Id: string? })
	-- Read BLOCK: 4 bytes
	local BLOCK_START = Read(4)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	local Value = {} :: any
	Value.Ok = (buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1)
	if buffer.readu8(RecieveBuffer, BLOCK_START + 2) == 1 then
		-- Read BLOCK: 2 bytes
		local BLOCK_START = Read(2)
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		Value.Message = buffer.readstring(RecieveBuffer, Read(Length), Length)
	end
	if buffer.readu8(RecieveBuffer, BLOCK_START + 3) == 1 then
		-- Read BLOCK: 2 bytes
		local BLOCK_START = Read(2)
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		Value.Id = buffer.readstring(RecieveBuffer, Read(Length), Length)
	end
	return Value
end

function SerdesFunctions.WriteFUNCTION_DATA_Probe(Value: { number }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 3 bytes
	local BLOCK_START = Allocate(3)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	-- START ARRAY
	buffer.writeu8(SendBuffer, BLOCK_START + 2, #Value)
		-- Allocate BLOCK: 8 bytes
	local ARRAY_START_1 = Allocate(8 * #Value)
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Allocate 8
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 8
		buffer.writef64(SendBuffer, OPERATION_OFFSET_0, Item_1)
	end
	-- END ARRAY
end

function SerdesFunctions.ReadFUNCTION_RETURN_Probe(): ({ { AssetId: number, Ok: boolean, Name: string?, Creator: string?, Len: number?, Pending: boolean? } })
	-- Read BLOCK: 3 bytes
	local BLOCK_START = Read(3)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	-- START ARRAY
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	if Length < 0 then error(`Expected "Length" to be larger than or equal to 0, got {Length} instead.`) end
	if Length > 65535 then error(`Expected "Length" to be smaller than or equal to 65535, got {Length} instead.`) end
	local Value = table.create(Length)
		-- Read BLOCK: 13 bytes
	local ARRAY_START_1 = Read(13 * Length)
	for Index = 1, Length do
		local Item_1 = {} :: any
		-- Read 8
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 8
		Item_1.AssetId = buffer.readf64(RecieveBuffer, OPERATION_OFFSET_0)
		-- Read 1
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 1
		Item_1.Ok = (buffer.readu8(RecieveBuffer, OPERATION_OFFSET_1) == 1)
		-- Read 1
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_2) == 1 then
			-- Read BLOCK: 2 bytes
			local BLOCK_START = Read(2)
			Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
			Item_1.Name = buffer.readstring(RecieveBuffer, Read(Length), Length)
		end
		-- Read 1
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_3) == 1 then
			-- Read BLOCK: 2 bytes
			local BLOCK_START = Read(2)
			Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
			Item_1.Creator = buffer.readstring(RecieveBuffer, Read(Length), Length)
		end
		-- Read 1
		local OPERATION_OFFSET_4 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_4) == 1 then
			-- Read BLOCK: 4 bytes
			local BLOCK_START = Read(4)
			Item_1.Len = buffer.readf32(RecieveBuffer, BLOCK_START + 0)
		end
		-- Read 1
		local OPERATION_OFFSET_5 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_5) == 1 then
			-- Read BLOCK: 1 bytes
			local BLOCK_START = Read(1)
			Item_1.Pending = (buffer.readu8(RecieveBuffer, BLOCK_START + 0) == 1)
		end
		table.insert(Value, Item_1)
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.WriteEVENT_Live(Value1: number, Value2: ("Pitch" | "Vol" | "Filter" | "EqHigh" | "EqMid" | "EqLow" | "Echo" | "Reverb" | "Flanger" | "Xfader" | "Curve" | "Master"), Value3: number): ()
	-- Allocate BLOCK: 7 bytes
	local BLOCK_START = Allocate(7)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 2)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Value1)
	if Value2 == "Pitch" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 0)
	elseif Value2 == "Vol" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	elseif Value2 == "Filter" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 2)
	elseif Value2 == "EqHigh" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 3)
	elseif Value2 == "EqMid" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 4)
	elseif Value2 == "EqLow" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 5)
	elseif Value2 == "Echo" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 6)
	elseif Value2 == "Reverb" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 7)
	elseif Value2 == "Flanger" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 8)
	elseif Value2 == "Xfader" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 9)
	elseif Value2 == "Curve" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 10)
	elseif Value2 == "Master" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 11)
	else
		error(`Unexpected enum: {Value2}, expected one of "Pitch" or "Vol" or "Filter" or "EqHigh" or "EqMid" or "EqLow" or "Echo" or "Reverb" or "Flanger" or "Xfader" or "Curve" or "Master".`)
	end
	buffer.writef32(SendBuffer, BLOCK_START + 3, Value3)
end

