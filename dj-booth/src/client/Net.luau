function SerdesFunctions.ReadEVENT_PadSfx(): (number, number, boolean)
	-- Read BLOCK: 13 bytes
	local BLOCK_START = Read(13)
	local Value1 = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
	if not (Value1 >= 1) then error(`Expected "Value1" to be larger than or equal to 1, got {Value1} instead.`) end
	if not (Value1 <= 9007199254740992) then error(`Expected "Value1" to be smaller than or equal to 9007199254740992, got {Value1} instead.`) end
	local Value2 = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
	if not (Value2 >= 0) then error(`Expected "Value2" to be larger than or equal to 0, got {Value2} instead.`) end
	if not (Value2 <= 2) then error(`Expected "Value2" to be smaller than or equal to 2, got {Value2} instead.`) end
	local Value3 = (buffer.readu8(RecieveBuffer, BLOCK_START + 12) == 1)
	return Value1, Value2, Value3
end

function SerdesFunctions.ReadEVENT_Toast(): (string)
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	local Value = buffer.readstring(RecieveBuffer, Read(Length), Length)
	if #Value < 0 then error(`Expected length of "Value" to be larger than or equal to 0, got {#Value} instead.`) end
	if #Value > 120 then error(`Expected length of "Value" to be smaller than or equal to  120, got {#Value} instead.`) end
	return Value
end

