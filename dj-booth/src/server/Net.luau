		if Value.Index > 8 then error(`Expected "Value.Index" to be smaller than or equal to 8, got {Value.Index} instead.`) end
		Value.Kind = "PadPress"
	elseif Tag == 33 then
		Value = {} :: any
		Value.Kind = "TakeBooth"
	elseif Tag == 34 then
		Value = {} :: any
		Value.Kind = "EndSet"
	elseif Tag == 35 then
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		Value = {} :: any
		local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		Value.Code = buffer.readstring(RecieveBuffer, Read(Length), Length)
		if #Value.Code < 1 then error(`Expected length of "Value.Code" to be larger than or equal to 1, got {#Value.Code} instead.`) end
		if #Value.Code > 128 then error(`Expected length of "Value.Code" to be smaller than or equal to  128, got {#Value.Code} instead.`) end
		Value.Kind = "Activate"
	elseif Tag == 36 then
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		Value = {} :: any
		local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		Value.Code = buffer.readstring(RecieveBuffer, Read(Length), Length)
		if #Value.Code < 1 then error(`Expected length of "Value.Code" to be larger than or equal to 1, got {#Value.Code} instead.`) end
		if #Value.Code > 128 then error(`Expected length of "Value.Code" to be smaller than or equal to  128, got {#Value.Code} instead.`) end
		Value.Kind = "RedeemGuest"
	else
		error(`Unexpected variant: {Tag}`)
	end
	return Value
end

function SerdesFunctions.WriteFUNCTION_RETURN_Do(Value: { Ok: boolean, Message: string?, Id: string? }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 6 bytes
	local BLOCK_START = Allocate(6)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.Ok and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.Message ~= nil and 1 or 0)
	if Value.Message ~= nil then
		-- Allocate BLOCK: 2 bytes
		local BLOCK_START = Allocate(2)
		local Length = #Value.Message
		buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.Message, Length)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 5, Value.Id ~= nil and 1 or 0)
	if Value.Id ~= nil then
		-- Allocate BLOCK: 2 bytes
		local BLOCK_START = Allocate(2)
		local Length = #Value.Id
		buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.Id, Length)
	end
end

function SerdesFunctions.ReadFUNCTION_DATA_Probe(): ({ number })
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	-- START ARRAY
	local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Length < 1 then error(`Expected "Length" to be larger than or equal to 1, got {Length} instead.`) end
	if Length > 20 then error(`Expected "Length" to be smaller than or equal to 20, got {Length} instead.`) end
	local Value = table.create(Length)
		-- Read BLOCK: 8 bytes
	local ARRAY_START_1 = Read(8 * Length)
	for Index = 1, Length do
		-- Read 8
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 8
		local Item_1 = buffer.readf64(RecieveBuffer, OPERATION_OFFSET_0)
		table.insert(Value, Item_1)
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.WriteFUNCTION_RETURN_Probe(Value: { { AssetId: number, Ok: boolean, Name: string?, Creator: string?, Len: number?, Pending: boolean? } }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 5 bytes
	local BLOCK_START = Allocate(5)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	-- START ARRAY
	buffer.writeu16(SendBuffer, BLOCK_START + 3, #Value)
		-- Allocate BLOCK: 13 bytes
	local ARRAY_START_1 = Allocate(13 * #Value)
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Allocate 8
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 8
		buffer.writef64(SendBuffer, OPERATION_OFFSET_0, Item_1.AssetId)
		-- Allocate 1
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_1, Item_1.Ok and 1 or 0)
		-- Allocate 1
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_2, Item_1.Name ~= nil and 1 or 0)
		if Item_1.Name ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			local Length = #Item_1.Name
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
			Allocate(Length)
			buffer.writestring(SendBuffer, SendOffset, Item_1.Name, Length)
		end
		-- Allocate 1
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_3, Item_1.Creator ~= nil and 1 or 0)
		if Item_1.Creator ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			local Length = #Item_1.Creator
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
			Allocate(Length)
			buffer.writestring(SendBuffer, SendOffset, Item_1.Creator, Length)
		end
		-- Allocate 1
		local OPERATION_OFFSET_4 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_4, Item_1.Len ~= nil and 1 or 0)
		if Item_1.Len ~= nil then
			-- Allocate BLOCK: 4 bytes
			local BLOCK_START = Allocate(4)
			buffer.writef32(SendBuffer, BLOCK_START + 0, Item_1.Len)
		end
		-- Allocate 1
		local OPERATION_OFFSET_5 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_5, Item_1.Pending ~= nil and 1 or 0)
		if Item_1.Pending ~= nil then
			-- Allocate BLOCK: 1 bytes
			local BLOCK_START = Allocate(1)
			buffer.writeu8(SendBuffer, BLOCK_START + 0, Item_1.Pending and 1 or 0)
		end
	end
	-- END ARRAY
end

function SerdesFunctions.ReadEVENT_Live(): (number, ("Pitch" | "Vol" | "Filter" | "EqHigh" | "EqMid" | "EqLow" | "Echo" | "Reverb" | "Flanger" | "Xfader" | "Curve" | "Master"), number)
	-- Read BLOCK: 6 bytes
	local BLOCK_START = Read(6)
	local Value1 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Value1 < 1 then error(`Expected "Value1" to be larger than or equal to 1, got {Value1} instead.`) end
	if Value1 > 2 then error(`Expected "Value1" to be smaller than or equal to 2, got {Value1} instead.`) end
	local Value2 = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 1)
	if Index == 0 then
		Value2 = "Pitch"
	elseif Index == 1 then
		Value2 = "Vol"
	elseif Index == 2 then
		Value2 = "Filter"
	elseif Index == 3 then
		Value2 = "EqHigh"
	elseif Index == 4 then
		Value2 = "EqMid"
	elseif Index == 5 then
		Value2 = "EqLow"
	elseif Index == 6 then
		Value2 = "Echo"
	elseif Index == 7 then
		Value2 = "Reverb"
	elseif Index == 8 then
		Value2 = "Flanger"
	elseif Index == 9 then
		Value2 = "Xfader"
	elseif Index == 10 then
		Value2 = "Curve"
	elseif Index == 11 then
		Value2 = "Master"
	else
		error(`Unexpected enum: {Index}`)
	end
	local Value3 = buffer.readf32(RecieveBuffer, BLOCK_START + 2)
	return Value1, Value2, Value3
end

function SerdesFunctions.ReadEVENT_Nudge(): (number, number)
	-- Read BLOCK: 5 bytes
	local BLOCK_START = Read(5)
	local Value1 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Value1 < 1 then error(`Expected "Value1" to be larger than or equal to 1, got {Value1} instead.`) end
	if Value1 > 2 then error(`Expected "Value1" to be smaller than or equal to 2, got {Value1} instead.`) end
	local Value2 = buffer.readf32(RecieveBuffer, BLOCK_START + 1)
	if not (Value2 >= -4) then error(`Expected "Value2" to be larger than or equal to -4, got {Value2} instead.`) end
	if not (Value2 <= 4) then error(`Expected "Value2" to be smaller than or equal to 4, got {Value2} instead.`) end
	return Value1, Value2
end

function SerdesFunctions.ReadEVENT_Ready(): (nil)
	return nil
end

function SerdesFunctions.WriteEVENT_Sync(Value: any): ()
	-- Allocate BLOCK: 1 bytes
	local BLOCK_START = Allocate(1)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 4)
	table.insert(SendInstances, if Value == nil then Null else Value)
end

function SerdesFunctions.WriteEVENT_WorldFx(Value1: number, Value2: number, Value3: number): ()
	-- Allocate BLOCK: 7 bytes
	local BLOCK_START = Allocate(7)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 5)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Value1)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, Value2)
	buffer.writef32(SendBuffer, BLOCK_START + 3, Value3)
end

function SerdesFunctions.WriteEVENT_PadSfx(Value1: number, Value2: number, Value3: boolean): ()
	-- Allocate BLOCK: 14 bytes
	local BLOCK_START = Allocate(14)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 6)
	buffer.writef64(SendBuffer, BLOCK_START + 1, Value1)
	buffer.writef32(SendBuffer, BLOCK_START + 9, Value2)
	buffer.writeu8(SendBuffer, BLOCK_START + 13, Value3 and 1 or 0)
end

function SerdesFunctions.WriteEVENT_Toast(Value: string): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 7)
	local Length = #Value
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value, Length)
end

